// Combos

COMB(ZX_CUT, LSFT(KC_DEL), KC_Z, KC_X)
COMB(XC_COPY, LCTL(KC_INS), KC_X, KC_C)
COMB(CV_PASTE, LSFT(KC_INS), KC_C, KC_V)

COMB(JC_CTRL_C, LCTL(KC_C), RCTL_T(KC_J), KC_C) // RCTL_T(KC_J) to match keymaps[]
COMB(JR_CTRL_R, LCTL(KC_R), RCTL_T(KC_J), KC_R) // RCTL_T(KC_J) to match keymaps[]
COMB(JS_CTRL_S, LCTL(KC_S), RCTL_T(KC_J), LSFT_T(KC_S)) // RCTL_T(KC_J) and LSFT_T(KC_S) to match keymaps[]

