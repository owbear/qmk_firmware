/////////
// Combos
// Note: must not use tap version in resulting keycode, i.e not RCTL_T(), just RCTL()


COMB(ZX_CUT, LSFT(KC_DEL), KC_Z, LSFT_T(KC_X)) // LSFT_T(KC_X)) to match keymaps[]
COMB(XC_COPY, LCTL(KC_INS), LSFT_T(KC_X), KC_C) // LSFT_T(KC_X)) to match keymaps[]
COMB(CV_PASTE, LSFT(KC_INS), KC_C, KC_V)

//////////////////////////////////////////////
// Common Right Ctrl+X combos as chords/combos
COMB(JC_CTRL_C, RCTL(KC_C), RCTL_T(KC_J), KC_C) // RCTL_T() to match keymaps[]
COMB(JR_CTRL_R, RCTL(KC_R), RCTL_T(KC_J), KC_R) // RCTL_T() to match keymaps[]
COMB(JS_CTRL_S, RCTL(KC_S), RCTL_T(KC_J), KC_S) // RCTL_T() to match keymaps[]

//////////////////////////////////////////////
// Common Left Shift+X combos as chords/combos
COMB(LSFT_KC_QUOT, LSFT(KC_QUOT), LSFT_T(KC_X), KC_QUOT) // LSFT_T() to match keymaps[]
COMB(LSFT_KC_SLSH, LSFT(KC_SLSH), LSFT_T(KC_X), KC_SLSH) // LSFT_T() to match keymaps[]
COMB(LSFT_KC_SCLN, LSFT(KC_SCLN), LSFT_T(KC_X), RGUI_T(KC_SCLN)) // LSFT_T() & RGUI_T() to match keymaps[]
