/////////
// Combos

COMB(ZX_CUT, LSFT(KC_DEL), KC_Z, LSFT_T(KC_X)) // LSFT_T(KC_X)) to match keymaps[]
COMB(XC_COPY, LCTL(KC_INS), LSFT_T(KC_X), KC_C) // LSFT_T(KC_X)) to match keymaps[]
COMB(CV_PASTE, LSFT(KC_INS), KC_C, KC_V)

// Must not use _T in resulting keycode, i.e not RCTL_T(), just RCTL()
COMB(JC_CTRL_C, RCTL(KC_C), RCTL_T(KC_J), KC_C) // RCTL_T(KC_J) to match keymaps[]
COMB(JR_CTRL_R, RCTL(KC_R), RCTL_T(KC_J), KC_R) // RCTL_T(KC_J) to match keymaps[]
COMB(JS_CTRL_S, RCTL(KC_S), RCTL_T(KC_J), KC_S) // RCTL_T(KC_J) to match keymaps[]

